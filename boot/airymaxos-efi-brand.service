# ===========================================================================
# airymaxos-efi-brand.service — 首启把 NVRAM 引导项换成 AirymaxOS
#
# anaconda 装机后留下的条目以 GRUB_DISTRIBUTOR（openEuler）命名，固件菜单
# 与 BootOrder 都是上游身份。改标签不可行，只能新建条目并置顶，故在首启
# 落一次；状态文件存在即短路，避免每次启动都写 NVRAM。
#
# 放在 local-fs.target 之后：ESP 与 /sys/firmware/efi 都要已就绪。oneshot
# 排在显示管理器之前，但不被 Require，脚本自身已把错误降级为 journal 记
# 录，正常不会进入 failed，也不会拖住图形目标。
# ===========================================================================
[Unit]
Description=AirymaxOS EFI boot entry branding
Documentation=https://atomgit.com/openairymax/agent-linux
ConditionPathExists=/sys/firmware/efi
ConditionPathExists=!/var/lib/airymaxos/efi-brand
After=local-fs.target
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/airymaxos/boot/efi_brand.sh

[Install]
WantedBy=multi-user.target
