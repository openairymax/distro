# SPDX-License-Identifier: AGPL-3.0-or-later OR Apache-2.0
# ===========================================================================
# verdict.env — 安装/启动判负证据集的唯一事实源
#
# 宿主机（scripts/install-test.sh）与会话内执行器（tools/osaccrt）都从这里
# 取正则，任何一侧都不得自带副本：判定集分叉会让同一次串口日志在两边得出
# 相反结论，而这类分歧在 CI 里只会表现成“偶发通过”，无法回溯。
#
# 文件格式为 bash 可直接 source 的 KEY='ERE' 赋值；正则使用 ERE，
# 交替符 | 不得被换行打断，因此每行一条完整表达式。
# ===========================================================================

# 启动腿的判负只认两类证据：引导层失败（panic、emergency、dracut 超时），
# 以及会话内探针给出的结论标记（AIRYMAX-BOOT-DEGRADED / DESKTOP-FAIL /
# SMOKE-FAIL）。「Failed to start」这类通用文本不进判定集：它出现在启动
# 前几秒，按它提前结束会让启动腿在桌面尚未拉起时就收尾，既掩盖「UKUI 能否
# 进入」的证据，也把单元失败与桌面失败混成同一个结论。单元失败以探针读到
# 的 systemd 记账为准，宿主机只做归因，不立第二个事实源。
BOOT_FAIL='Kernel panic|Welcome to emergency mode|dracut-initqueue.*timeout|AIRYMAX-BOOT-DEGRADED|AIRYMAX-DESKTOP-FAIL|AIRYMAX-SMOKE-FAIL'

# 安装腿的引导层与安装结论失败。
INST_FAIL='Kernel panic|Fatal glibc error|dracut-initqueue.*timeout|AIRYMAX-INSTALL-FAIL'

# rpm 事务级错误（依赖解析失败、文件冲突、scriptlet 失败）会让 anaconda
# 停在“按 ENTER 退出:” 等待输入而不退出进程，必须与安装失败标记同等判负。
# 「conflicts between attempted installs of」是 rpm 在事务检查阶段给出的
# 文件冲突证据，出现在致命错误菜单之前，是这类失败唯一稳定的文本特征。
#
# scriptlet 非零退出在 anaconda 里上升为事务错误，不是可忽略的告警：
# run 40939234612 在 sound-theme-freedesktop (428/1278) 处命中 POSTIN，
# anaconda 随即打印「安装负载时出现以下错误。这是个致命错误，安装将中止。」
# 与「An error occurred during the transaction: Error in POSTIN scriptlet
# in rpm package sound-theme-freedesktop」，停在「按 ENTER 退出:」。
# 把该行当告警会让无头安装空耗 --install-timeout；run 40917625246 曾被读成
# 「anaconda 继续装下一个包」，其实那一轮日志停在 428/1278，是因为宿主在
# 命中该行一秒后就杀掉 QEMU，把自己造成的终止读成了 anaconda 中止。
# 根因是 %post 无兜底，由 scripts/lib/guard.sh 在载荷侧重打包消除；判据
# 侧仍按失败处理，不放宽。
RPM_FAIL='An error occurred during the transaction|conflicts between attempted installs of|Error in (PREIN|POSTIN|PREUN|POSTUN|PRETRANS|POSTTRANS|TRIGGERIN|TRIGGERUN|TRIGGERPOSTUN) scriptlet in rpm package'

# 取包失败（仓库不可达、单一镜像重试耗尽）在 anaconda 里是致命错误，随后
# 停在「按 ENTER 退出:」等待输入；无头安装没有 stdin，进程既不自退也不打
# 失败标记，只能空耗 --install-timeout。取包致命提示本身即失败证据。
PAY_FAIL='Failed to download the following packages|安装负载时出现以下错误|There was an error installing the packages|Cannot download, all mirrors were already tried'

# anaconda 在配置阶段遇到无法自处理的错误时转为交互问句（引导装载程序写
# 配置失败即属此类），无头安装没有 stdin，进程不会退出也不会打印失败标记，
# 只能等到 --install-timeout。问句本身即失败证据。
#
# 「Please make your choice from above:」是 anaconda TUI 致命错误菜单
# （1) Report Bug 2) Debug 3) Run shell 4) Quit）的等待句。事务失败后
# anaconda 不一定回落到「按 ENTER 退出」，也可能停在该菜单，故必须收录，
# 否则整段只能空耗 --install-timeout。
#
# 同一句的中文形态「请从上方进行选择」必须单列：安装配方锁 zh_CN.UTF-8，
# anaconda 的交互主菜单因此只打中文，英文形态永远匹配不到。run
# 41144010592 的 run-bios-1 正是这样空转满 3600 秒——存储配置被 anaconda
# 判为无效（BIOS+GPT 缺 biosboot），主菜单第 5 项标 [!] 并停在该问句，
# 而判定集只有英文，心跳只能一路报「串口静默」。
ASK_FAIL='failed to write boot loader configuration|Please answer .yes. or .no.|请回答 .yes. 或 .no.|按 ENTER 退出|Press ENTER to exit|Please make your choice from above|请从上方进行选择'
