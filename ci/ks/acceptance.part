# AIRYMAX-ACCEPTANCE-FIXTURE
# 验收夹具（0.0.3 B 轮）。本文件不得进入产品配方：
# tools/gen_accept_ks.py 在构建期把它插入 workstation kickstart 的
# 收尾命令之前，产物只落在源码区之外的构建目录。
%post --nochroot --log=/root/airymax-acceptance.log
set -eu

# 1) %post 默认在目标 chroot 内执行，看不到安装介质；夹具脚本必须
#    在 nochroot 环境从 /run/install/repo 复制到目标系统。
root="${ANA_INSTALL_PATH:-/mnt/sysimage}"
install -d -m 0755 "${root}/usr/lib/airymaxos/ci"
install -m 0755 /run/install/repo/run-smoke.sh \
    "${root}/usr/lib/airymaxos/ci/run-smoke.sh"
install -m 0755 /run/install/repo/fixture/airymax-smoke-run.sh \
    "${root}/usr/lib/airymaxos/ci/airymax-smoke-run.sh"
install -m 0755 /run/install/repo/fixture/airymax-smoke-report.sh \
    "${root}/usr/lib/airymaxos/ci/airymax-smoke-report.sh"
install -m 0644 /run/install/repo/fixture/airymax-smoke-report.service \
    "${root}/usr/lib/systemd/system/airymax-smoke-report.service"
install -m 0755 /run/install/repo/fixture/airymax-alive.sh \
    "${root}/usr/lib/airymaxos/ci/airymax-alive.sh"
install -m 0644 /run/install/repo/fixture/airymax-alive.service \
    "${root}/usr/lib/systemd/system/airymax-alive.service"
install -m 0644 /run/install/repo/fixture/airymax-alive.timer \
    "${root}/usr/lib/systemd/system/airymax-alive.timer"
%end

%post --log=/root/airymax-acceptance.log
set -eu

# 2) 同一观测点只允许一个判定者：产品就绪单元让位给会话内冒烟。
#    安装器 chroot 内没有 systemd 总线，单元文件操作走 --root 离线语义。
systemctl --root=/ mask airymax-desktop-ready.service

# 3) 无人值守验收没有键盘输入：自动登录必须由产品侧的
#    /etc/lightdm/lightdm.conf.d/50-airymax.conf 提供。这里只断言，不再
#    自写一份配置——否则产品资产退化成空时，验收依然会绿。
lightdm=/etc/lightdm/lightdm.conf.d/50-airymax.conf
for want in 'autologin-user=amuser' 'autologin-session=ukui'; do
    if ! grep -qx "${want}" "${lightdm}" 2>/dev/null; then
        echo "AIRYMAX-ACCEPT-FAIL lightdm ${want}" >&2
        exit 1
    fi
done

#    同一批断言覆盖 SSH 侧：空口令账户没有 PermitEmptyPasswords 就没有
#    远程入口，属于 P0 交付缺口，必须在装机段判负而不是留给现场发现。
sshd_dropin=/etc/ssh/sshd_config.d/50-airymax-sshd.conf
if ! grep -qx 'PermitEmptyPasswords yes' "${sshd_dropin}" 2>/dev/null; then
    echo "AIRYMAX-ACCEPT-FAIL sshd PermitEmptyPasswords" >&2
    exit 1
fi

#    口令认证只留给 amuser。全局开着会让每次连接先以空口令走一次 PAM，
#    有口令的账户因此被 pam_faillock 记账，公钥登录几次之后就被锁定。
if ! grep -qx 'PasswordAuthentication no' "${sshd_dropin}" 2>/dev/null ||
   ! grep -qx 'Match User amuser' "${sshd_dropin}" 2>/dev/null; then
    echo "AIRYMAX-ACCEPT-FAIL sshd password policy" >&2
    exit 1
fi

# 4) 冒烟结果目录：会话用户写入，root 报告单元读取。
install -d -o amuser -g amuser -m 0755 /var/log/airymax

# 5) 会话建立后自动启动冒烟。
cat > /etc/xdg/autostart/airymax-smoke.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=AirymaxOS acceptance smoke
Exec=/usr/lib/airymaxos/ci/airymax-smoke-run.sh
NoDisplay=true
Terminal=false
EOF

# 6) 报告单元把 TAP 判定转发到串口。
systemctl --root=/ enable airymax-smoke-report.service

# 6b) 存活心跳：会话没起来时，唯一能证明「PID1 还在跑、缺的是图形设备还是
#     图形会话」的通道。报告单元挂在 graphical.target 之后，目标到不了就
#     永远不会执行，正是最需要证据的那一类故障。
systemctl --root=/ enable airymax-alive.timer

# 7) 冷启动取证面：产品默认把内核口压到 loglevel 4，验收镜像要能回答
#    「卡在哪」。三处缺口各补一层，只动本夹具，不进产品配方：
#    a) 内核口放开——去掉 quiet/rhgb 并加 ignore_loglevel，让 dmesg、
#       hung task、NMI watchdog 这类内核侧事实直接落串口。启动失败常常
#       发生在用户态之前，静默的内核口等于没有证据。
#    b) journald 转发到串口——登录管理器、X 服务器、桌面会话的日志由
#       各自进程写 journal，systemd 作业表没有新行时串口就静止；转发后
#       即使 PID1 不再打印状态，串口仍能看到它们发出的最后一行。
#       TTYPath 必须显式写成串口设备：缺省落点 /dev/console 归内核命令行
#       里最后一个 console=，产品命令行是
#       console=ttyS0,115200 console=tty0，用户态的每一行都停在本地屏上。
#       run 41925092075 的冷启动因此在 3.9 秒后彻底静默，探针判负也没有
#       一行落到串口。
#    c) 停滞判定——默认 hung_task_timeout_secs=120 比 --boot-timeout
#       短不了多少，且 sysrq 被关掉后宿主侧无法取栈；验收镜像打开 sysrq
#       并缩短阈值，配合 airy-boot-watch 的卡点快照构成完整证据链。
#    grubby 只在装了 grub2 的镜像上存在；改动失败不阻断装机，取证面缺失
#    会以「启动日志很安静」的形式暴露，而不是让验收镜像装不完。
command -v grubby >/dev/null 2>&1 &&
    grubby --update-kernel=ALL \
        --remove-args="quiet rhgb" \
        --args="ignore_loglevel systemd.show_status=yes" >/dev/null || :

install -d -m 0755 /etc/systemd/journald.conf.d
cat > /etc/systemd/journald.conf.d/50-acceptance-console.conf <<'EOF'
[Journal]
ForwardToConsole=yes
TTYPath=/dev/ttyS0
MaxLevelConsole=info
RateLimitIntervalSec=0
EOF

cat > /etc/sysctl.d/60-acceptance-stall.conf <<'EOF'
kernel.sysrq = 1
kernel.hung_task_timeout_secs = 20
kernel.hung_task_warnings = 10
kernel.nmi_watchdog = 1
kernel.watchdog_thresh = 10
EOF
%end
