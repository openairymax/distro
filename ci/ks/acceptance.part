# AIRYMAX-ACCEPTANCE-FIXTURE
# 验收夹具（0.0.3 B 轮）。本文件不得进入产品配方：
# tools/gen_accept_ks.py 在构建期把它插入 workstation kickstart 的
# 收尾命令之前，产物只落在源码区之外的构建目录。
%post --nochroot --log=/root/airymax-acceptance.log
set -eu

# 1) %post 默认在目标 chroot 内执行，看不到安装介质；夹具脚本必须
#    在 nochroot 环境从 /run/install/repo 复制到目标系统。
root="${ANA_INSTALL_PATH:-/mnt/sysimage}"
install -d -m 0755 "${root}/usr/lib/airymaxos/ci"
install -m 0755 /run/install/repo/run-smoke.sh \
    "${root}/usr/lib/airymaxos/ci/run-smoke.sh"
install -m 0755 /run/install/repo/fixture/airymax-smoke-run.sh \
    "${root}/usr/lib/airymaxos/ci/airymax-smoke-run.sh"
install -m 0755 /run/install/repo/fixture/airymax-smoke-report.sh \
    "${root}/usr/lib/airymaxos/ci/airymax-smoke-report.sh"
install -m 0644 /run/install/repo/fixture/airymax-smoke-report.service \
    "${root}/usr/lib/systemd/system/airymax-smoke-report.service"
%end

%post --log=/root/airymax-acceptance.log
set -eu

# 2) 同一观测点只允许一个判定者：产品就绪单元让位给会话内冒烟。
#    安装器 chroot 内没有 systemd 总线，单元文件操作走 --root 离线语义。
systemctl --root=/ mask airymax-desktop-ready.service

# 3) 无人值守验收没有键盘输入：自动登录必须由产品侧的
#    /etc/lightdm/lightdm.conf.d/50-airymax.conf 提供。这里只断言，不再
#    自写一份配置——否则产品资产退化成空时，验收依然会绿。
lightdm=/etc/lightdm/lightdm.conf.d/50-airymax.conf
for want in 'autologin-user=airymax' 'autologin-session=ukui'; do
    if ! grep -qx "${want}" "${lightdm}" 2>/dev/null; then
        echo "AIRYMAX-ACCEPT-FAIL lightdm ${want}" >&2
        exit 1
    fi
done

#    同一批断言覆盖 SSH 侧：空口令账户没有 PermitEmptyPasswords 就没有
#    远程入口，属于 P0 交付缺口，必须在装机段判负而不是留给现场发现。
sshd_dropin=/etc/ssh/sshd_config.d/50-airymax-sshd.conf
if ! grep -qx 'PermitEmptyPasswords yes' "${sshd_dropin}" 2>/dev/null; then
    echo "AIRYMAX-ACCEPT-FAIL sshd PermitEmptyPasswords" >&2
    exit 1
fi

# 4) 冒烟结果目录：会话用户写入，root 报告单元读取。
install -d -o airymax -g airymax -m 0755 /var/log/airymax

# 5) 会话建立后自动启动冒烟。
cat > /etc/xdg/autostart/airymax-smoke.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=AirymaxOS acceptance smoke
Exec=/usr/lib/airymaxos/ci/airymax-smoke-run.sh
NoDisplay=true
Terminal=false
EOF

# 6) 报告单元把 TAP 判定转发到串口。
systemctl --root=/ enable airymax-smoke-report.service
%end
