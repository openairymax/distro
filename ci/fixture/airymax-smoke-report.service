# ===========================================================================
# airymax-smoke-report — 验收 ISO 的串口结果上报
#
# 仅存在于 B 轮验收 ISO；产品 ISO 不安装本单元。失败退出码由
# install-test.sh 的 BOOT_FAIL 规则捕获（AIRYMAX-SMOKE-FAIL）。
# ===========================================================================
[Unit]
Description=AirymaxOS acceptance smoke report
Documentation=https://atomgit.com/openairymax/agent-linux
ConditionPathExists=/usr/lib/airymaxos/ci/airymax-smoke-report.sh
After=lightdm.service
Wants=lightdm.service

[Service]
Type=oneshot
ExecStart=/usr/lib/airymaxos/ci/airymax-smoke-report.sh
# 明细按原文逐行转发，含探针报出的中文字体名；本地屏的 VT 字体没有 CJK
# 字形，journal+console 会把明细整份搬成方块。屏幕上的结论由脚本经
# con_put 单独写出（一行 ASCII），明细走串口与 journal 各自的通道。
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300

[Install]
WantedBy=graphical.target
