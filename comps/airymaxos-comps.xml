<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE comps PUBLIC "-//Airymax//DTD Comps 1.0//EN" "comps.dtd">
<!--
  SPDX-License-Identifier: AGPL-3.0-or-later OR Apache-2.0
  AirymaxOS 包组定义（comps）

  桌面决策（2026-09-15）：OS 侧系统桌面 = UKUI 4.x（openKylin/openEuler 线），
  以 RPM 形态随 Euler 包生态进入镜像，禁止 vendor 源码。
  基础仓库：openEuler 24.03 LTS-SP2 的 OS、update、EPOL/main、
  EPOL/update/main、everything 五个仓库（与 kickstart 配置一致；
  其中 everything 只补齐主仓库缺失的桌面依赖，如 qt5-qtgraphicaleffects、
  qt5-qtquickcontrols）。包名已按该冻结点实际仓库逐一核对；
  新增条目必须先确认可从上述仓库解析，否则安装会直接失败。
-->
<comps>
  <!-- 基础系统组：openEuler 24.03 LTS-SP2 comps 中 core 组
       mandatory + default 的投影，剔除上游身份包与上游内核
       （kernel / kernel-tools / openEuler-release /
       openEuler-latest-release 由本产品的 airymaxos-kernel 与
       airymaxos-release 取代），并补入安装器无条件需要的
       grub2、grub2-tools 与 chrony。配方以 %packages 的 nocore
       选项关闭 anaconda 隐式追加的 @core，改由本组显式供包，
       使构建期求解与安装期事务读同一份定义。 -->
  <group>
    <id>airymax-core</id>
    <name>AirymaxOS Core</name>
    <name xml:lang="zh_CN">AirymaxOS 基础系统</name>
    <description>Base operating system</description>
    <description xml:lang="zh_CN">基础系统（引导、系统服务、包管理与安全策略）</description>
    <default>false</default>
    <uservisible>false</uservisible>
    <packagelist>
      <packagereq type="mandatory">audit</packagereq>
      <packagereq type="mandatory">basesystem</packagereq>
      <packagereq type="mandatory">bash</packagereq>
      <!-- 安装器引导阶段无条件追加（GRUB2.packages） -->
      <packagereq type="mandatory">grub2</packagereq>
      <packagereq type="mandatory">grub2-tools</packagereq>
      <!-- 安装器时区模块的 NTP 依赖（NTP_PACKAGE） -->
      <packagereq type="mandatory">chrony</packagereq>
      <packagereq type="mandatory">coreutils</packagereq>
      <packagereq type="mandatory">cronie</packagereq>
      <packagereq type="mandatory">curl</packagereq>
      <packagereq type="mandatory">dnf</packagereq>
      <packagereq type="mandatory">e2fsprogs</packagereq>
      <packagereq type="mandatory">filesystem</packagereq>
      <packagereq type="mandatory">firewalld</packagereq>
      <packagereq type="mandatory">glibc</packagereq>
      <packagereq type="mandatory">grubby</packagereq>
      <packagereq type="mandatory">hostname</packagereq>
      <packagereq type="mandatory">initscripts</packagereq>
      <packagereq type="mandatory">iproute</packagereq>
      <packagereq type="mandatory">iprutils</packagereq>
      <packagereq type="mandatory">iputils</packagereq>
      <packagereq type="mandatory">irqbalance</packagereq>
      <packagereq type="mandatory">kbd</packagereq>
      <packagereq type="mandatory">kexec-tools</packagereq>
      <packagereq type="mandatory">less</packagereq>
      <packagereq type="mandatory">man-db</packagereq>
      <packagereq type="mandatory">ncurses</packagereq>
      <packagereq type="mandatory">openssh</packagereq>
      <packagereq type="mandatory">openssh-server</packagereq>
      <packagereq type="mandatory">openssh-clients</packagereq>
      <packagereq type="mandatory">parted</packagereq>
      <packagereq type="mandatory">passwd</packagereq>
      <packagereq type="mandatory">policycoreutils</packagereq>
      <packagereq type="mandatory">procps-ng</packagereq>
      <packagereq type="mandatory">rng-tools</packagereq>
      <packagereq type="mandatory">rootfiles</packagereq>
      <packagereq type="mandatory">rpm</packagereq>
      <packagereq type="mandatory">selinux-policy-targeted</packagereq>
      <packagereq type="mandatory">setup</packagereq>
      <packagereq type="mandatory">shadow</packagereq>
      <packagereq type="mandatory">sssd</packagereq>
      <packagereq type="mandatory">sudo</packagereq>
      <packagereq type="mandatory">systemd</packagereq>
      <packagereq type="mandatory">tuned</packagereq>
      <packagereq type="mandatory">util-linux</packagereq>
      <packagereq type="mandatory">vim-minimal</packagereq>
      <packagereq type="mandatory">xfsprogs</packagereq>
      <packagereq type="mandatory">yum</packagereq>
      <packagereq type="mandatory">wget</packagereq>
      <packagereq type="default">NetworkManager</packagereq>
      <packagereq type="default">NetworkManager-config-server</packagereq>
      <packagereq type="default">authselect</packagereq>
      <packagereq type="default">dnf-plugins-core</packagereq>
      <packagereq type="default">dracut-config-rescue</packagereq>
      <packagereq type="default">iptables-nft</packagereq>
      <packagereq type="default">sysfsutils</packagereq>
      <packagereq type="default">linux-firmware</packagereq>
      <packagereq type="default">lshw</packagereq>
      <packagereq type="default">lsscsi</packagereq>
      <packagereq type="default">rsyslog</packagereq>
      <packagereq type="default">security-tool</packagereq>
      <packagereq type="default">sg3_utils</packagereq>
      <packagereq type="default">systemd-cryptsetup</packagereq>
    </packagelist>
  </group>

  <!-- 核心组：最小可启动 UKUI 桌面会话 -->
  <group>
    <id>airymax-desktop-core</id>
    <name>AirymaxOS Desktop Core (UKUI)</name>
    <name xml:lang="zh_CN">AirymaxOS 桌面核心（UKUI）</name>
    <description>Minimal bootable UKUI desktop session</description>
    <description xml:lang="zh_CN">最小可启动的 UKUI 桌面会话（会话 + 窗管 + 登录管理器）</description>
    <default>false</default>
    <uservisible>false</uservisible>
    <packagelist>
      <!-- 发行版标识与桌面策略载体；kickstart %post 校验其存在，
           提供 airymax-desktop.slice、UKUI 策略脚本与默认壁纸 -->
      <packagereq type="mandatory">airymaxos-release</packagereq>
      <!-- UKUI 元包（EPOL）：Requires 已覆盖会话、窗管、面板、控制中心、
           截图/归档/图片查看、字体与 ukui-greeter，勿在桌面组重复声明 -->
      <packagereq type="mandatory">ukui</packagereq>
      <!-- X11 服务端：真实包名 xorg-x11-server，它 Provides
           xorg-x11-server-Xorg / Xorg（后者不是包名） -->
      <packagereq type="mandatory">xorg-x11-server</packagereq>
      <!-- X11 诊断客户端（xdpyinfo）：桌面冒烟 T1 的 X server 可达性探针
           依赖此包；仓库内位于 OS，包名与版本已核对 -->
      <packagereq type="default">xorg-x11-utils</packagereq>
      <!-- 显示管理器：ukui-greeter 自带 95-ukui-greeter.conf 接入 lightdm，
           显式声明使 kickstart 的 services 指令有实包可依 -->
      <packagereq type="mandatory">lightdm</packagereq>
      <!-- 音频：UKUI 通过 libpulse 播放提示音与音量控制，不依赖 PipeWire
           守护进程（pipewire 仅存在于 everything 仓库，镜像不启用） -->
      <packagereq type="default">pulseaudio</packagereq>
      <!-- 图形栈：DRI 驱动提供软件渲染与 libgbm，缺省时会话可启动但
           窗口管理器无 GL 后端 -->
      <packagereq type="default">mesa-dri-drivers</packagereq>
      <!-- 会话总线：X11 客户端通过 dbus-launch 接入会话总线 -->
      <packagereq type="default">dbus-x11</packagereq>
      <!-- 授权服务：ukui-polkit 依赖 polkit 守护进程 -->
      <packagereq type="default">polkit</packagereq>
    </packagelist>
  </group>

  <!-- 完整桌面组：核心 + 终端 + 文件管理器 + 输入法 + 基础应用 -->
  <group>
    <id>airymax-desktop</id>
    <name>AirymaxOS Desktop (UKUI)</name>
    <name xml:lang="zh_CN">AirymaxOS 桌面（UKUI）</name>
    <description>Full AirymaxOS desktop with UKUI</description>
    <description xml:lang="zh_CN">AirymaxOS 完整桌面环境（UKUI + 基础应用 + 输入法）</description>
    <default>false</default>
    <uservisible>true</uservisible>
    <packagelist>
      <!-- 文件管理器（ukui 元包应带入 peony，此处显式声明以防元包漂移） -->
      <packagereq type="default">peony</packagereq>
      <!-- 终端：EPOL 提供 mate-terminal（无 ukui-terminal 包） -->
      <packagereq type="default">mate-terminal</packagereq>
      <!-- 输入法：冻结点只有 fcitx 4.x 系列（无 fcitx5），
           libpinyin 提供中文拼音引擎，configtool/qt5 提供配置与 Qt 支持 -->
      <packagereq type="default">fcitx</packagereq>
      <packagereq type="default">fcitx-libpinyin</packagereq>
      <packagereq type="default">fcitx-configtool</packagereq>
      <packagereq type="default">fcitx-qt5</packagereq>
      <!-- 浏览器：firefox 由 openEuler EPOL 提供，列为 optional，
           默认安装集（mandatory + default）不含浏览器 -->
      <packagereq type="optional">firefox</packagereq>
    </packagelist>
    <!-- 会话/窗管/登录管理器/音频栈/分级冻结的唯一定义在核心组，
         此处以组引用复用，避免同一包清单两处维护产生漂移 -->
    <grouplist>
      <groupid>airymax-desktop-core</groupid>
    </grouplist>
  </group>

  <!-- 可选扩展组：默认不装 -->
  <group>
    <id>airymax-desktop-extras</id>
    <name>AirymaxOS Desktop Extras</name>
    <name xml:lang="zh_CN">AirymaxOS 桌面扩展</name>
    <description>Optional desktop extras</description>
    <description xml:lang="zh_CN">桌面可选扩展（截图/压缩/多媒体等，按冻结点可用性补充）</description>
    <default>false</default>
    <uservisible>true</uservisible>
    <packagelist>
      <packagereq type="optional">ukui-biometric-manager</packagereq>
      <packagereq type="optional">ukui-power-manager</packagereq>
      <packagereq type="optional">peony-extensions</packagereq>
    </packagelist>
  </group>

  <!-- 安装环境：Anaconda 软件选择里作为一个整体环境出现 -->
  <environment>
    <id>airymax-workstation</id>
    <name>AirymaxOS Workstation</name>
    <name xml:lang="zh_CN">AirymaxOS 工作站</name>
    <description>Agent OS workstation with UKUI desktop</description>
    <description xml:lang="zh_CN">智能体操作系统工作站（UKUI 桌面 + 系统层组件）</description>
    <display_order>99</display_order>
    <grouplist>
      <groupid>airymax-core</groupid>
      <groupid>airymax-desktop-core</groupid>
      <groupid>airymax-desktop</groupid>
    </grouplist>
    <optionlist>
      <groupid>airymax-desktop-extras</groupid>
    </optionlist>
  </environment>
</comps>
