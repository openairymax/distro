# 00-airymax-screensaver — AirymaxOS 锁屏策略
#
# 部署：随 airymaxos-release 包安装为
# /etc/dconf/db/local.d/00-airymax-screensaver，由 %post 的 dconf update
# 编译进 /etc/dconf/db/local。/etc/dconf/profile/user 含 system-db:local，
# 该库在每个用户会话里先于用户 db 生效，因此对交付账户与其他账户一致。
#
# 为什么关掉空闲锁屏（0.0.3 决策）：交付账户 airymax 在 kickstart %post 中
# 以 passwd -d 落地为空口令。锁屏挡不住任何人，却会在空闲 5 分钟后弹出
# 口令框，把「开机即桌面」变成「每五分钟输入一次口令」。锁屏与免密登录是
# 同一口径的两端，不能只做一半。
#
# 为什么还要关掉「睡眠即锁定」（0.0.4 实机取证）：285H 冷启动后合盖再
# 打开，屏幕上只剩锁屏问句，被当成「开机卡住」。取证发现 dconf 系统库已
# 生效（lock-enabled=false、idle-lock-enabled=false），唯一仍在生效的
# 锁定入口是 sleep-activation-enabled=true——该键的描述就是「系统睡眠时
# 锁定屏幕」，与另两个键各自独立判定。空口令账户在锁屏上无口令可输，
# 于是挂起唤醒等于把机器锁死。三个锁定入口必须一并收敛，缺一即复发。
#
# 为什么连「空闲激活」也一并关掉（0.0.4 285H 复验）：UKUI 3.1 的空闲激活
# 不是一张中性的屏保画面，而是 ukui-screensaver-dialog --session-idle——一张
# 与登录界面同形的对话，带用户头像与「登录」按钮。前两个键关掉后它不再校
# 验口令（同账户可直接结束），但每次空闲 5 分钟仍会盖住桌面，用户看到的是
# 「系统又锁上了」，必须先操作一次才能回到桌面。285H 实测：关闭
# idle-activation-enabled 后再无 --session-idle 进程拉起，桌面保持可见。
#
# 收敛范围：关「空闲激活」「空闲锁定」「屏保激活即锁定」「睡眠即锁定」四
# 个键。DPMS 省电（由 ukui-power-manager 的熄屏策略负责）不动，显示器照常
# 熄灭；需要锁屏时仍可手动执行 ukui-screensaver-command -l。greeter 侧由
# lightdm 的 autologin 座位处理，不由本文件覆盖。
# ===========================================================================
[org/ukui/screensaver]
idle-activation-enabled=false
idle-lock-enabled=false
lock-enabled=false
sleep-activation-enabled=false
