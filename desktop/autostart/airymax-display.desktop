# 部署：airymaxos-release 包安装到 /etc/xdg/autostart/。
# 由 ukui-session 的 XDG autostart 机制在会话内拉起，晚于 xinitrc.d 钩子，
# 覆盖 settings-daemon 就绪后重新设置模式的时序。预算 30 秒：收敛即退出，
# 不占用常驻资源。
# 不写 OnlyShowIn：openEuler 冻结点只有 UKUI 一个会话，写死桌面标识反而
# 会在标识不一致时静默失效。
[Desktop Entry]
Type=Application
Name=AirymaxOS Display Mode
Comment=Converge session outputs onto the AirymaxOS display policy
Exec=/usr/lib/airymaxos/desktop/display_mode.sh --settle 30
Terminal=false
NoDisplay=true
