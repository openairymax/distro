# 部署：airymaxos-release 包安装到 /etc/xdg/autostart/。
# 由 ukui-session 的 XDG autostart 机制在 X11 会话内拉起 ibus-daemon。
# -d 转后台、-r 替换既有实例、-x 同时提供 XIM 服务（遗留 Xlib 应用）。
# 不写 OnlyShowIn：openEuler 冻结点只有 UKUI 一个会话，写死桌面标识反而
# 会在标识不一致时静默失效。
[Desktop Entry]
Type=Application
Name=AirymaxOS Input Method
Comment=Start the ibus input method for the desktop session
Exec=/usr/bin/ibus-daemon -drx
Icon=ibus
Terminal=false
NoDisplay=true
