# SPDX-License-Identifier: AGPL-3.0-or-later OR Apache-2.0
# 部署：airymaxos-release 包安装到 /usr/share/glib-2.0/schemas/。
#
# UKUI 桌面背景由 peony-qt-desktop 依据 org.mate.background 绘制；该 schema
# 由 mate-desktop-libs 提供（ukui-settings-daemon 的硬依赖）。此处只覆盖
# 默认图片路径，其余键沿用 schema 默认值（picture-options=zoom 等），避免
# 与用户级设置产生双重事实来源。
[org.mate.background]
picture-filename='/usr/share/backgrounds/airymaxos/qilian_photo_from_zhenyi.jpg'

# GTK 侧图标主题：org.mate.interface 的 schema 默认值是 menta，而本镜像的
# 包闭包里没有 menta-icon-theme，目录也不存在。GTK 应用因此拿不到 ukui
# 专有图标（设备、状态、应用），只剩 hicolor 里的通用图形。UKUI 自身的
# org.ukui.style icon-theme-name 已经是 ukui，两处取值必须一致，否则同一台
# 机器上 Qt 与 GTK 应用显示两套图标。
[org.mate.interface]
icon-theme='ukui'
