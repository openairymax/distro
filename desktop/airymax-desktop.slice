# ===========================================================================
# airymax-desktop.slice — 桌面低干扰 cgroup slice
#
# 目的：桌面会话与 agent 负载在调度面上隔离（对应 desktop/README.md 决策 3）。
# 权重制（50/100）而非限额制：桌面繁忙时让路，agent 空闲时桌面可用满额。
#
# 部署：随 airymaxos-release 包安装到 %{_unitdir}。会话级挂接由同包的
# /etc/systemd/system/user@.service.d/50-airymax-desktop.conf 完成，systemd
# 按 slice 名称自动创建父 slice，无需显式 Requires 或 target 挂接。
# ===========================================================================
[Unit]
Description=AirymaxOS desktop session slice (low-interference)
Documentation=https://atomgit.com/openairymax/distro
Before=slices.target

[Slice]
# CPU/IO 权重：桌面整体让位于 agent 工作负载（默认 100）
CPUWeight=50
IOWeight=50
# 任务数上限防失控（相对值，桌面场景足够）
TasksMax=40%
# 不设 MemoryMax/MemoryHigh：桌面自身已有应用级内存管理，双重限额会在
# 内存紧张时放大回收冲突，反而制造体验 cliff。
