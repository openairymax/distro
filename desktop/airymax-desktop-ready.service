# ===========================================================================
# airymax-desktop-ready — 安装后的启动与桌面就绪探针
#
# WantedBy=graphical.target：只在图形目标下运行；minimal 剖面停留在
# multi-user.target，不会触发本单元。探针同时上报 systemd 的失败记账
# （AIRYMAX-BOOT-HEALTH / AIRYMAX-BOOT-DEGRADED），失败退出码由
# install-test.sh 的 BOOT_FAIL 规则捕获，作为「OS 不能正常运行」与
# 「UKUI 桌面进不去」的宿主机可判定证据。
# ===========================================================================
[Unit]
Description=AirymaxOS boot and desktop readiness probe
Documentation=https://atomgit.com/openairymax/agent-linux
ConditionFileIsExecutable=/usr/sbin/lightdm
After=lightdm.service
Wants=lightdm.service

[Service]
Type=oneshot
ExecStart=/usr/lib/airymaxos/desktop/desktop_ready.sh
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=180

[Install]
WantedBy=graphical.target
