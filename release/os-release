# AirymaxOS release identity — single source of truth for VERSION_ID.
# Installed as /usr/lib/os-release with /etc/os-release symlinked to it.
#
# 品牌串规则只有一条：凡进入非 UTF-8 通道的名字一律 ASCII。NAME 与
# PRETTY_NAME 都在这条规则内，原因是二者的消费方都在控制台侧：
#   - PRETTY_NAME 派生 ISO 卷标与 .treeinfo、/etc/system-release、
#     /etc/issue 首行，build-iso 的字符白名单直接拒绝非 ASCII；
#   - NAME 被 openEuler 的 /etc/grub.d/10_linux 原样读进菜单标题
#     （OS_NAME="$(grep ^NAME= /etc/os-release ...)"，模板
#     "%s (%s) %s"），而 GRUB 只加载 unicode.pf2——该字体不含 CJK 字形，
#     中文全部落空。285H 实测：菜单标题的「开源极境」四个字整段不显示。
# 产品中文名不进 os-release，只落文档与桌面侧展示；os-release 是机器面。
# NAME 与 PRETTY_NAME 同词根，由 run-smoke 的 T9 逐条断言。
# VERSION 是「版本名称」的展示源（ukui-control-center 的关于页直读此键），
# 与 PRETTY_NAME 同形：「<ASCII 短名> <VERSION_ID>」，避免两处各写一套口径。
NAME="OpenAirymax"
VERSION="OpenAirymax 0.0.4"
ID=airymaxos
ID_LIKE="openeuler"
VERSION_ID="0.0.4"
# 构件来源指纹：仓库内为空，组装期由 airymaxos-release 的 %install 按
# airy_build_id 改写，并与 /etc/airymaxos-build 逐字相同。装好的系统据此
# 反查「这份镜像由哪次构建产出」，无需再依赖镜像文件名或外部台账。
BUILD_ID=""
PRETTY_NAME="OpenAirymax 0.0.4"
VERSION_CODENAME=openairymax
VARIANT="Workstation"
# 不声明 VARIANT_ID：openEuler 24.03 的 firewalld %posttrans 按 VARIANT_ID 选择
# 变体配置并对其执行 sed -i，而该包只发布 firewalld-standard.conf。声明
# workstation 会生成悬空符号链接，sed 以非零退出，anaconda 判定 scriptlet
# 失败并中止安装。VARIANT 仅作人类可读信息，不参与打包分支。
HOME_URL="https://atomgit.com/openairymax/agent-linux"
BUG_REPORT_URL="https://atomgit.com/openairymax/agent-linux/issues"
ANSI_COLOR="0;34"
LOGO=airymaxos-logo
